{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node", "express", "jest"],
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "rootDir": "../../"
  },
  "include": [
    "src/**/*.ts",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx",
    "../../packages/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "out-tsc",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
